# Application Port
PORT=3000

# Meta Messenger Webhook Configuration
# VERIFY_TOKEN: Custom string set in Meta App Dashboard -> Messenger -> Webhooks
VERIFY_TOKEN=your_meta_webhook_verify_token_here

# PAGE_ACCESS_TOKEN: Page Access Token generated in Meta App Dashboard
PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# Google Gemini API Key for Gemini 2.5 Flash Audio Transcription & Summarization
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (optional fallback)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override system FFmpeg binary path if needed
# FFMPEG_PATH=/usr/bin/ffmpeg
